}

params:query {
  cmd: start_file_playback
  media_url: nfs://10.0.0.1:/VideoStorage:/SomeFolder/file.mkv
  speed: 0
  position: 0
  black_screen: 1
  hide_osd: 1
  action_on_finish: restart_playback
}
