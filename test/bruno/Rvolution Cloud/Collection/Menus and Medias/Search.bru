  ~IsParentalControlActive: false
}

headers {
  Accept: application/json
}

body:json {
  {
    "ApiKey": "{{apiKey}}",
    "AuthKey": "{{authKey}}",
    "Word": "Who",
    "Collection": "{{firstCollectionId}}",
    "IsParentalControlActive": false
  }
}
