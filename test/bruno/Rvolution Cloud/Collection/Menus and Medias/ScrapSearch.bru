meta {
  name: ScrapSearch
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/ScrapSearch
  body: json
  auth: none
}

params:query {
  ~AuthKey: {{authKey}}
  ~Collection: {{firstCollectionId}}
  ~Word: Blade
  ~ApiKey: {{apiKey}}
  ~IsParentalControlActive: false
}

headers {
  Accept: application/json
}

body:json {
  {
    "ApiKey": "{{apiKey}}",
    "AuthKey": "{{authKey}}",
    "Collection": "{{firstCollectionId}}",
    "ById": null,
    "ByTitle": "blade",
    "ItemType": "Movie"
  }
}
